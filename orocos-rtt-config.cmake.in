########################################################################################################################
#  Target-specific definitions. This is currently only the include paths.
#
########################################################################################################################


# Prefix used to distinguish imported targets from regular ones
set(PREFIX @IMPORTED_TARGET_PREFIX@)

# Path to headers
get_filename_component(OROCOS-RTT_INCLUDE_DIRS "${SELF_DIR}/../../../include/orocos" ABSOLUTE)
list( APPEND OROCOS-RTT_INCLUDE_DIRS "@OROCOS-RTT_INCLUDE_DIRS@" @CORBA_INCLUDE_DIRS@ @MQ_INCLUDE_DIRS@ )
set(OROCOS_RTT_TARGET_CFLAGS "@RTT_USER_CFLAGS@")
if(OROCOS_RTT_TARGET_CFLAGS)
  separate_arguments(OROCOS_RTT_TARGET_CFLAGS UNIX_COMMAND "${OROCOS_RTT_TARGET_CFLAGS}")
  foreach(OROCOS_RTT_TARGET_CFLAG ${OROCOS_RTT_TARGET_CFLAGS})
    if(OROCOS_RTT_TARGET_CFLAG MATCHES "^-I(.+)")
      list(APPEND OROCOS-RTT_INCLUDE_DIRS "${CMAKE_MATCH_1}")
    else()
      list(APPEND OROCOS-RTT_TARGET_DEFINITIONS "${OROCOS_RTT_TARGET_CFLAG}")
    endif()
  endforeach()
endif()
list( REMOVE_DUPLICATES OROCOS-RTT_INCLUDE_DIRS )
list( REMOVE_DUPLICATES OROCOS-RTT_TARGET_DEFINITIONS )

#Used CORBA IMPLEMENTATION
set(CORBA_IMPLEMENTATION @CORBA_IMPLEMENTATION@)
